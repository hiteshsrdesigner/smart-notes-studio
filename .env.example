# Smart Notes Studio runs entirely client-side and needs NO environment
# variables to function. This file exists as a placeholder for optional,
# future server-side AI features (see README.md "AI architecture").
#
# VITE_* variables are bundled into the client and are PUBLIC — never put a
# secret API key in a VITE_* variable. If a future AI feature needs a key,
# add it to a serverless function's own (non-VITE_) environment instead.
VITE_AI_ENABLED=false
